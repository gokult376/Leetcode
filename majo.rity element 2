class Solution {
    public List<Integer> majorityElement(int[] nums) {
        HashMap<Integer,Integer> map=new HashMap<>();
        int a=nums.length;
        for(int n:nums){
            map.put(n,map.getOrDefault(n,0)+1);
        }
        ArrayList<Integer> c=new ArrayList<>();
        for(int b:map.keySet()){
            if(map.get(b)>a/3){
                c.add(b);
            }
        }
        return c;

    }
}
